<?xml version="1.0" encoding="utf-8"?>

<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/lightGreen">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- Greeting -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Hello! 👋"
            android:textSize="26sp"
            android:textStyle="bold"
            android:textColor="@color/darkGreen"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Let's reduce food waste today 🌍"
            android:textSize="15sp"
            android:textColor="@color/gray"
            android:layout_marginTop="4dp"/>

        <!-- Impact Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp"
            android:background="@drawable/splash_background"
            android:layout_marginTop="22dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🌱 Your Impact"
                android:textSize="20sp"
                android:textStyle="bold"
                android:textColor="@color/white"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="You've started making a difference!"
                android:textSize="14sp"
                android:textColor="@color/white"
                android:layout_marginTop="8dp"/>

        </LinearLayout>

        <!-- Statistics -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Quick Overview"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="@color/darkGreen"
            android:layout_marginTop="25dp"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:weightSum="2"
            android:layout_marginTop="12dp">

            <TextView
                android:id="@+id/tvPantryCount"
                android:layout_width="0dp"
                android:layout_height="100dp"
                android:layout_weight="1"
                android:gravity="center"
                android:text="🥕\n\nPantry\n0 Items"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="@color/darkGreen"
                android:background="@color/white"/>

            <TextView
                android:id="@+id/tvExpiryCount"
                android:layout_width="0dp"
                android:layout_height="100dp"
                android:layout_weight="1"
                android:layout_marginStart="10dp"
                android:gravity="center"
                android:text="⏰\n\nExpiring Soon\n0 Items"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="@color/orange"
                android:background="@color/white"/>

        </LinearLayout>

        <!-- Quick Actions -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Quick Actions"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="@color/darkGreen"
            android:layout_marginTop="25dp"/>

        <Button
            android:id="@+id/btnPantry"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:text="🥬  Manage My Pantry"
            android:textStyle="bold"
            android:textColor="@color/white"
            android:backgroundTint="@color/primaryGreen"
            android:layout_marginTop="12dp"/>

        <Button
            android:id="@+id/btnRecipe"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:text="🤖  Get AI Recipe"
            android:textStyle="bold"
            android:textColor="@color/white"
            android:backgroundTint="@color/primaryGreen"
            android:layout_marginTop="10dp"/>

        <Button
            android:id="@+id/btnExpiry"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:text="⏰  Check Expiry"
            android:textStyle="bold"
            android:textColor="@color/white"
            android:backgroundTint="@color/orange"
            android:layout_marginTop="10dp"/>

        <Button
            android:id="@+id/btnReports"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:text="📊  View My Impact"
            android:textStyle="bold"
            android:textColor="@color/white"
            android:backgroundTint="@color/darkGreen"
            android:layout_marginTop="10dp"
            android:layout_marginBottom="20dp"/>

    </LinearLayout>

</ScrollView>